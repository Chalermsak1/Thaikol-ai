# ==============================================================================
# ThaiKOL AI — Environment Configuration
# ==============================================================================

# Application Mode
ENVIRONMENT=development
# Mode: false = LIVE mode (default), true = deterministic offline DEMO mode
DEMO_MODE=false
PROJECT_NAME="ThaiKOL AI"
API_V1_STR="/api/v1"
SECRET_KEY=insecure-default-change-in-production-thaikol-ai-secret

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thaikol_db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/thaikol_db

# AI & LLM Profiler Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# External Data Providers (Apify for Public Scraping)
# Set your Apify API Token to enable LIVE TikTok creator discovery and Facebook page extraction
APIFY_API_TOKEN=
APIFY_FACEBOOK_ACTOR_ID=apify/facebook-pages-scraper
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper

# TikTok Discovery Limits & Controls
TIKTOK_MAX_QUERIES=5
TIKTOK_MAX_RESULTS_PER_QUERY=20
TIKTOK_MAX_CANDIDATES=50
TIKTOK_TIMEOUT=60.0
TIKTOK_RETRY_ATTEMPTS=3
TIKTOK_RETRY_BACKOFF_BASE=1.5

# Data Freshness Thresholds (Hours)
DATA_FRESHNESS_PROFILE_HOURS=6
DATA_FRESHNESS_VIDEO_HOURS=24
DATA_FRESHNESS_BRAND_HOURS=24

# Extraction Limits & Security
WEBSITE_EXTRACT_TIMEOUT=10.0
WEBSITE_MAX_RESPONSE_SIZE=2097152
WEBSITE_MAX_TEXT_LENGTH=15000

# Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Security & Networking
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
LOG_LEVEL=INFO

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
